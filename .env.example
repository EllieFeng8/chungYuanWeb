# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
# Vite also explicitly allows doukeyi.aeyeot.co as a dev/preview host.
APP_URL="https://doukeyi.aeyeot.co"

# Optional local overrides for Vite dev / preview.
PORT="3000"
PREVIEW_PORT="4173"
DISABLE_HMR="true"
# Only set these when your dev proxy/tunnel needs an explicit Vite HMR socket.
# Leave them unset for normal localhost development.
# https://doukeyi.aeyeot.co requires the proxy to forward WebSocket upgrades.
HMR_HOST="doukeyi.aeyeot.co"
HMR_PROTOCOL="wss"
HMR_CLIENT_PORT="443"
HMR_PATH="/vite-hmr"

# Chinafood API BFF config
CFCT_BASE_URL="https://cfct.sditt.com.tw"
CFCT_API_KEY="cfct_live_p5w0RK-IiPazqIMe6eASp0vb5dT0RcmlLFvPls5Jwr4"
BFF_PORT="8787"
BFF_URL="http://127.0.0.1:8787"
